# Upstox developer app: access token expires according to your app/token policy.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=
APP_ENV=production
TZ=Asia/Kolkata
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
MIN_SCORE=75
EXPLOSION_MIN_SCORE=80
ENTRY_MODE=close
FILTER_PROFILE=strict
SIGNAL_ONLY=true
# Bounded REST scan concurrency; keep conservative to avoid provider rate limits.
SCAN_CONCURRENCY=4
# Cache historical warm-up candles; current-session candles are always refreshed.
HISTORICAL_CACHE_TTL_SEC=1800
CAPITAL=100000
RISK_PCT=0.5
DB_BACKEND=memory
DATABASE_URL=
REDIS_URL=
